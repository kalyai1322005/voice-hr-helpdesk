# Required for voice: create a key at https://app.gnani.ai
GNANI_API_KEY=your-key-here

# Optional: voice name from the Gnani Voice Catalog (docs.gnani.ai)
GNANI_VOICE=Nalini

# Optional: any OpenAI-compatible LLM endpoint for smarter intent detection,
# e.g. Gnani Evon v3.3 served with vLLM. Leave blank to use keyword rules.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
